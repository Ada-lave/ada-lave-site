---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import About from '../../components/About.astro';
import Skills from '../../components/Skills.astro';
import Projects from '../../components/Projects.astro';
import Contact from '../../components/Contact.astro';
import Footer from '../../components/Footer.astro';
import { site } from '../../data/config';
import { en as t } from '../../i18n/en';
---

<Layout title={t.meta.title} description={t.meta.description} lang={t.lang}>
  <!-- Nav -->
  <nav class="fixed top-0 left-0 right-0 z-50 border-b border-[rgba(206,66,43,0.2)] bg-[rgba(13,13,13,0.85)] backdrop-blur-md">
    <div class="max-w-6xl mx-auto px-6 h-14 flex items-center justify-between">
      <a href="#hero" class="font-mono text-sm font-semibold text-[#f0f0f0] hover:text-[#ce422b] transition-colors">
        <span class="text-[#ce422b]">vs</span><span class="text-[#909090]">_</span>shuvalov
      </a>
      <div class="hidden sm:flex items-center gap-6">
        {t.nav.map(link => (
          <a href={link.href} class="font-mono text-xs text-[#909090] hover:text-[#ce422b] transition-colors">
            ./{link.label}
          </a>
        ))}
      </div>
      <div class="flex items-center gap-2">
        <a href={t.langSwitchHref}
           class="font-mono text-xs text-[#909090] border border-[rgba(144,144,144,0.3)] rounded px-3 py-1 hover:text-[#f0f0f0] hover:border-[rgba(144,144,144,0.6)] transition-all"
           data-umami-event="nav-lang-switch">
          {t.langSwitch}
        </a>
        <a href={site.github} target="_blank" rel="noopener noreferrer"
           class="font-mono text-xs text-[#ce422b] border border-[rgba(206,66,43,0.3)] rounded px-3 py-1 hover:bg-[rgba(206,66,43,0.1)] transition-all"
           data-umami-event="nav-github">
          GitHub ↗
        </a>
      </div>
    </div>
  </nav>

  <!-- Offset for fixed nav -->
  <div class="h-14"></div>

  <main>
    <Hero t={t.hero} />
    <About t={t.about} />
    <Skills t={t.skills} />
    <Projects t={t.projects} />
    <Contact t={t.contact} />
  </main>

  <Footer t={t.footer} />
</Layout>
