---
import { site, socials } from '../data/config';
import type { Translations } from '../i18n/types';

interface Props {
  t: Translations['hero'];
}
const { t } = Astro.props;
---
<section id="hero" class="min-h-dvh flex flex-col items-center justify-center relative border-b border-[rgba(206,66,43,0.3)]">
  <div class="max-w-6xl mx-auto px-6 w-full grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center py-12">

    <!-- Left -->
    <div>
      <!-- Heading -->
      <h1 class="text-3xl xl:text-4xl font-semibold leading-tight mb-5">{site.name}</h1>
      <p aria-hidden="true" class="font-mono text-2xl xl:text-3xl font-semibold leading-tight mb-5">
        <span class="text-primary">let</span>
        <span class="text-[#f0f0f0]"> dev </span>
        <span class="text-[#909090]">=</span>
        <br />
        <span class="text-[#e5c07b]">Developer</span><span class="text-[#909090]">::</span><span class="text-[#61afef]">new</span><span class="text-[#909090]">();</span>
      </p>

      <!-- Subtitle -->
      <p class="text-[#909090] text-base leading-relaxed mb-8">
        <Fragment set:html={t.subtitle} /><br />
        {site.stack.map((lang, i) => (
          <>
            <span class="text-primary font-mono">{lang}</span>{i < site.stack.length - 1 ? (i === site.stack.length - 2 ? ' & ' : ', ') : '.'}
          </>
        ))}
      </p>

      <!-- CTA buttons -->
      <div class="flex flex-wrap gap-3 mb-8">
        <a href="#projects" class="btn-primary" data-umami-event="hero-cta-projects">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>
          {t.ctaProjects}
        </a>
        <a href="#contact" class="btn-outline" data-umami-event="hero-cta-contact">{t.ctaContact}</a>
      </div>

      <!-- Socials -->
      <div class="flex flex-wrap gap-x-5 gap-y-1 hero-socials">
        {socials.map(s => (
          <a href={s.href}
             target={s.href.startsWith('mailto:') ? undefined : '_blank'}
             rel={s.href.startsWith('mailto:') ? undefined : 'noopener noreferrer'}
             class="min-h-11 flex items-center gap-1.5 font-mono text-[0.8125rem] text-[#909090] hover:text-primary transition-colors"
             data-umami-event={`social-${s.label.toLowerCase()}`}>
            <span set:html={s.icon} />
            {s.label}
          </a>
        ))}
      </div>

      <a
        href="https://codetime.dev"
        target="_blank"
        rel="noopener noreferrer"
        class="codetime-card mt-6"
        data-umami-event="hero-codetime-badge"
        aria-label="CodeTime badge"
      >
        <span class="codetime-label">
          <span class="text-primary">$</span>
          codetime
        </span>
        <img
          src={site.codetimeBadge}
          alt="CodeTime badge"
          loading="lazy"
          width="240" height="32"
          class="codetime-image"
        />
      </a>
    </div>

    <!-- Right: Terminal window -->
    <div class="min-w-0">
      <div class="bg-[#1a1a1a] border border-[rgba(206,66,43,0.3)] rounded-lg overflow-hidden shadow-2xl">
        <!-- Titlebar -->
        <div class="flex items-center gap-3 px-3 py-2.5 bg-[#252525] border-b border-[rgba(206,66,43,0.3)]">
          <div class="flex gap-1.5">
            <span class="w-3 h-3 rounded-full bg-[#ff5f57]"></span>
            <span class="w-3 h-3 rounded-full bg-[#febc2e]"></span>
            <span class="w-3 h-3 rounded-full bg-[#28c840]"></span>
          </div>
          <div class="flex gap-1" id="hero-tabs" aria-label={t.ctaProjects === 'Проекты' ? 'Язык примера кода' : 'Code language'}>
            <button data-lang="rust" class="tab-btn active-tab px-3 py-1 font-mono text-xs rounded-sm border border-transparent cursor-pointer transition-all">main.rs</button>
            <button data-lang="go"   class="tab-btn px-3 py-1 font-mono text-xs rounded-sm border border-transparent cursor-pointer transition-all text-[#909090] hover:text-[#f0f0f0] hover:border-[rgba(206,66,43,0.3)]">main.go</button>
            <button data-lang="python" class="tab-btn px-3 py-1 font-mono text-xs rounded-sm border border-transparent cursor-pointer transition-all text-[#909090] hover:text-[#f0f0f0] hover:border-[rgba(206,66,43,0.3)]">main.py</button>
          </div>
        </div>

        <!-- Code body -->
        <div class="px-6 py-5 min-h-[340px] relative">
          <pre id="code-rust" class="code-panel font-mono text-[0.8125rem] leading-7 text-[#f0f0f0] m-0 whitespace-pre overflow-x-auto"><code><span class="c-comment">// {site.name}</span>
<span class="c-keyword">use</span> std<span class="c-punct">::</span>collections<span class="c-punct">::</span><span class="c-type">HashMap</span><span class="c-punct">;</span>

<span class="c-keyword">struct</span> <span class="c-type">Developer</span> <span class="c-bracket">{</span>
    name<span class="c-punct">:</span> <span class="c-type">String</span><span class="c-punct">,</span>
    stack<span class="c-punct">:</span> <span class="c-type">Vec</span><span class="c-punct">&lt;</span><span class="c-type">String</span><span class="c-punct">&gt;,</span>
    location<span class="c-punct">:</span> <span class="c-type">String</span><span class="c-punct">,</span>
<span class="c-bracket">}</span>

<span class="c-keyword">impl</span> <span class="c-type">Developer</span> <span class="c-bracket">{</span>
    <span class="c-keyword">fn</span> <span class="c-fn">new</span><span class="c-bracket">()</span> <span class="c-punct">-&gt;</span> <span class="c-type">Self</span> <span class="c-bracket">{</span>
        <span class="c-type">Developer</span> <span class="c-bracket">{</span>
            name<span class="c-punct">:</span> <span class="c-string">"{site.name}"</span><span class="c-punct">,</span>
            stack<span class="c-punct">:</span> <span class="c-macro">vec!</span><span class="c-bracket">[</span><span class="c-string">"Rust"</span><span class="c-punct">,</span> <span class="c-string">"Go"</span><span class="c-punct">,</span> <span class="c-string">"Python"</span><span class="c-bracket">]</span><span class="c-punct">,</span>
            location<span class="c-punct">:</span> <span class="c-string">"{site.location}"</span><span class="c-punct">,</span>
        <span class="c-bracket">}</span>
    <span class="c-bracket">}</span>
<span class="c-bracket">}</span>

<span class="c-keyword">fn</span> <span class="c-fn">main</span><span class="c-bracket">()</span> <span class="c-bracket">{</span>
    <span class="c-keyword">let</span> dev <span class="c-punct">=</span> <span class="c-type">Developer</span><span class="c-punct">::</span><span class="c-fn">new</span><span class="c-bracket">()</span><span class="c-punct">;</span>
    <span class="c-macro">println!</span><span class="c-bracket">(</span><span class="c-string">"Hello, {}!"</span><span class="c-punct">,</span> dev<span class="c-punct">.</span>name<span class="c-bracket">)</span><span class="c-punct">;</span>
<span class="c-bracket">}</span></code></pre>

          <pre id="code-go" class="code-panel hidden font-mono text-[0.8125rem] leading-7 text-[#f0f0f0] m-0 whitespace-pre overflow-x-auto"><code><span class="c-comment">// {site.name}</span>
<span class="c-keyword">package</span> main

<span class="c-keyword">import</span> <span class="c-string">"fmt"</span>

<span class="c-keyword">type</span> <span class="c-type">Developer</span> <span class="c-keyword">struct</span> <span class="c-bracket">{</span>
    Name     <span class="c-type">string</span>
    Stack    <span class="c-bracket">[]</span><span class="c-type">string</span>
    Location <span class="c-type">string</span>
<span class="c-bracket">}</span>

<span class="c-keyword">func</span> <span class="c-fn">NewDeveloper</span><span class="c-bracket">()</span> <span class="c-type">Developer</span> <span class="c-bracket">{</span>
    <span class="c-keyword">return</span> <span class="c-type">Developer</span><span class="c-bracket">{</span>
        Name<span class="c-punct">:</span>     <span class="c-string">"{site.name}"</span><span class="c-punct">,</span>
        Stack<span class="c-punct">:</span>    <span class="c-bracket">[]</span><span class="c-type">string</span><span class="c-bracket">{</span><span class="c-string">"Go"</span><span class="c-punct">,</span> <span class="c-string">"Rust"</span><span class="c-punct">,</span> <span class="c-string">"Python"</span><span class="c-bracket">}</span><span class="c-punct">,</span>
        Location<span class="c-punct">:</span> <span class="c-string">"Yekaterinburg"</span><span class="c-punct">,</span>
    <span class="c-bracket">}</span>
<span class="c-bracket">}</span>

<span class="c-keyword">func</span> <span class="c-fn">main</span><span class="c-bracket">()</span> <span class="c-bracket">{</span>
    dev <span class="c-punct">:=</span> <span class="c-fn">NewDeveloper</span><span class="c-bracket">()</span>
    fmt<span class="c-punct">.</span><span class="c-fn">Printf</span><span class="c-bracket">(</span><span class="c-string">"Hello, %s!\n"</span><span class="c-punct">,</span> dev<span class="c-punct">.</span>Name<span class="c-bracket">)</span>
<span class="c-bracket">}</span></code></pre>

          <pre id="code-python" class="code-panel hidden font-mono text-[0.8125rem] leading-7 text-[#f0f0f0] m-0 whitespace-pre overflow-x-auto"><code><span class="c-comment"># {site.name}</span>
<span class="c-keyword">from</span> dataclasses <span class="c-keyword">import</span> dataclass
<span class="c-keyword">from</span> typing <span class="c-keyword">import</span> <span class="c-type">List</span>

<span class="c-macro">@dataclass</span>
<span class="c-keyword">class</span> <span class="c-type">Developer</span><span class="c-punct">:</span>
    name<span class="c-punct">:</span> <span class="c-type">str</span>
    stack<span class="c-punct">:</span> <span class="c-type">List</span><span class="c-bracket">[</span><span class="c-type">str</span><span class="c-bracket">]</span>
    location<span class="c-punct">:</span> <span class="c-type">str</span>

    <span class="c-macro">@classmethod</span>
    <span class="c-keyword">def</span> <span class="c-fn">new</span><span class="c-bracket">(</span>cls<span class="c-bracket">)</span> <span class="c-punct">-&gt;</span> <span class="c-string">"Developer"</span><span class="c-punct">:</span>
        <span class="c-keyword">return</span> cls<span class="c-bracket">(</span>
            name<span class="c-punct">=</span><span class="c-string">"{site.name}"</span><span class="c-punct">,</span>
            stack<span class="c-punct">=</span><span class="c-bracket">[</span><span class="c-string">"Python"</span><span class="c-punct">,</span> <span class="c-string">"Rust"</span><span class="c-punct">,</span> <span class="c-string">"Go"</span><span class="c-bracket">]</span><span class="c-punct">,</span>
            location<span class="c-punct">=</span><span class="c-string">"Yekaterinburg"</span><span class="c-punct">,</span>
        <span class="c-bracket">)</span>

<span class="c-keyword">if</span> __name__ <span class="c-punct">==</span> <span class="c-string">"__main__"</span><span class="c-punct">:</span>
    dev <span class="c-punct">=</span> <span class="c-type">Developer</span><span class="c-punct">.</span><span class="c-fn">new</span><span class="c-bracket">()</span>
    <span class="c-fn">print</span><span class="c-bracket">(</span><span class="c-string">f"Hello, &#123;dev.name&#125;!"</span><span class="c-bracket">)</span></code></pre>

          <!-- Status bar -->
          <div class="flex justify-between pt-3 mt-3 border-t border-white/5">
            <span id="hero-status-lang" class="font-mono text-[0.6875rem] text-primary uppercase tracking-wider">rust</span>
            <span class="font-mono text-[0.6875rem] text-[#909090] uppercase tracking-wider">UTF-8</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="scroll-indicator absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2">
    <span class="font-mono text-[0.6875rem] text-[#909090] uppercase tracking-widest">{t.scroll}</span>
    <div class="scroll-line"></div>
  </div>
</section>

<style>
  .active-tab {
    color: var(--color-primary);
    background: rgba(206, 66, 43, 0.1);
    border-color: rgba(206, 66, 43, 0.3) !important;
  }

  .codetime-card {
    display: inline-flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 0.875rem 1rem;
    border: 1px solid rgba(206, 66, 43, 0.3);
    border-radius: 0.75rem;
    background:
      linear-gradient(180deg, rgba(37, 37, 37, 0.92), rgba(26, 26, 26, 0.92));
    box-shadow:
      inset 0 1px 0 rgba(240, 240, 240, 0.04),
      0 12px 30px rgba(0, 0, 0, 0.24);
    text-decoration: none;
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease,
      background 0.2s ease;
  }

  .codetime-card:hover {
    transform: translateY(-2px);
    border-color: rgba(206, 66, 43, 0.5);
    box-shadow:
      inset 0 1px 0 rgba(240, 240, 240, 0.06),
      0 16px 36px rgba(0, 0, 0, 0.32),
      0 0 0 1px rgba(206, 66, 43, 0.08);
  }

  .codetime-label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    width: fit-content;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #909090;
  }

  .codetime-image {
    display: block;
    width: 240px;
    max-width: 100%;
    height: 2rem;
    object-fit: contain;
    object-position: left;
    filter: saturate(0.9) contrast(1.02);
    opacity: 0.92;
    transition:
      filter 0.2s ease,
      opacity 0.2s ease;
  }

  .codetime-card:hover .codetime-image {
    filter: saturate(1.05) contrast(1.08);
    opacity: 1;
  }
</style>

<script>
  import { initTabs } from '../scripts/tabs';

  const badge = document.querySelector<HTMLImageElement>('.codetime-image');
  if (badge) {
    const hideFailedBadge = () => { badge.hidden = true; badge.style.display = 'none'; };
    badge.addEventListener('error', hideFailedBadge);
    if (badge.complete && !badge.naturalWidth) hideFailedBadge();
  }

  initTabs({
    tabsSelector: '#hero-tabs .tab-btn',
    panelSelector: '.code-panel',
    dataAttr: 'lang',
    panelIdPrefix: 'code-',
    activeClass: 'active-tab',
    statusId: 'hero-status-lang',
  });
</script>
