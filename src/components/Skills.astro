---
import SectionHeading from './SectionHeading.astro';
import Homelab from './Homelab.astro';
import { configTabs, cargo, goMod, pip } from '../data/stack';
import type { CargoDep, GoDep, PipDep } from '../types';
import type { Lang, Translations } from '../i18n/types';

interface Props {
  t: Translations['skills'];
  homelabT: Translations['homelab'];
  lang: Lang;
}
const { t, homelabT, lang } = Astro.props;

// ── Cargo.toml ──────────────────────────────────────────────────────────────
const cargoMaxLen = Math.max(...cargo.deps.map(d => d.name.length));

function renderCargoValue(dep: CargoDep): string {
  if (dep.features) {
    const feats = dep.features.map(f => `<span class="c-string">"${f}"</span>`).join(', ');
    return `<span class="c-bracket">{</span> version = <span class="c-string">"${dep.version}"</span>, features = <span class="c-bracket">[</span>${feats}<span class="c-bracket">]</span> <span class="c-bracket">}</span>`;
  }
  return `<span class="c-string">"${dep.version}"</span>`;
}

const cargoHtml = [
  `<span class="c-bracket">[</span><span class="c-type">package</span><span class="c-bracket">]</span>`,
  `name    = <span class="c-string">"${cargo.pkg.name}"</span>`,
  `version = <span class="c-string">"${cargo.pkg.version}"</span>`,
  `edition = <span class="c-string">"${cargo.pkg.edition}"</span>`,
  ``,
  `<span class="c-bracket">[</span><span class="c-type">dependencies</span><span class="c-bracket">]</span>`,
  ...cargo.deps.map(dep => {
    const pad = ' '.repeat(cargoMaxLen - dep.name.length + 1);
    return `${dep.name}${pad}= ${renderCargoValue(dep)}`;
  }),
  ``,
  `<span class="c-bracket">[</span><span class="c-type">profile.release</span><span class="c-bracket">]</span>`,
  `opt-level = <span class="c-macro">${cargo.profile.optLevel}</span>`,
  `lto       = <span class="c-string">"${cargo.profile.lto}"</span>`,
].join('\n');

// ── go.mod ───────────────────────────────────────────────────────────────────
const goMaxLen = Math.max(...goMod.require.map(d => d.path.length));

const goHtml = [
  `module ${goMod.module}`,
  ``,
  `go <span class="c-macro">${goMod.version}</span>`,
  ``,
  `require <span class="c-bracket">(</span>`,
  ...goMod.require.map((dep: GoDep) => {
    const pad = ' '.repeat(goMaxLen - dep.path.length + 3);
    return `    ${dep.path}${pad}<span class="c-string">${dep.version}</span>`;
  }),
  `<span class="c-bracket">)</span>`,
].join('\n');

// ── requirements.txt ─────────────────────────────────────────────────────────
function pipDepHtml(dep: PipDep): string {
  return `${dep.name}<span class="c-punct">==</span><span class="c-macro">${dep.version}</span>`;
}

const pipHtml = [
  `<span class="c-comment"># requirements.txt</span>`,
  ...pip.deps.map(pipDepHtml),
  ``,
  `<span class="c-comment"># Dev</span>`,
  ...pip.devDeps.map(pipDepHtml),
].join('\n');

const panelHtml: Record<string, string> = {
  cargo: cargoHtml,
  gomod: goHtml,
  pip:   pipHtml,
};
---
<section id="skills" class="py-20 lg:py-28 border-t border-[rgba(206,66,43,0.15)]">
  <div class="max-w-6xl mx-auto px-6">

    <SectionHeading title={t.title}>
      <Fragment slot="prefix">
        <span class="text-primary">use</span>
        <span> crate</span><span class="text-[#909090]">::</span><span class="text-[#e5c07b]">skills</span><span>;</span>
      </Fragment>
    </SectionHeading>

    <div class="grid grid-cols-1 lg:grid-cols-[1.35fr_1fr] gap-10 lg:gap-12">

      <p class="text-sm text-[#909090] lg:col-span-2">{t.title === 'Навыки' ? 'Самооценка опыта работы с технологиями.' : 'Self-assessed experience with each technology.'}</p>
      <!-- Skill bars -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
        {t.groups.map(group => (
          <div class="flex flex-col gap-3">
            <h3 class="font-mono text-sm text-[#a0a6b1] italic">{group.label}</h3>
            <div class="flex flex-col gap-2.5">
              {group.skills.map(skill => (
                <div>
                  <div class="flex justify-between gap-3 mb-1">
                    <span class="font-mono text-[0.8125rem] text-[#f0f0f0]">{skill.name}</span>
                    <span class="font-mono text-[0.75rem] text-primary">{skill.level}%</span>
                  </div>
                  <div class="h-1 bg-[#252525] rounded-full overflow-hidden">
                    <div role="meter" aria-label={skill.name} aria-valuemin="0" aria-valuemax="100" aria-valuenow={skill.level} class="skill-fill" style={`--target: ${skill.level}%`}></div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>

      <!-- Config panel -->
      <div class="self-start bg-[#1a1a1a] border border-[rgba(206,66,43,0.3)] rounded overflow-hidden">
        <div class="flex border-b border-[rgba(206,66,43,0.3)] bg-[#252525]" id="cfg-tabs" aria-label={t.title === 'Навыки' ? 'Конфигурация стека' : 'Stack configuration'}>
          {configTabs.map((tab, i) => (
            <button
              data-file={tab.id}
              class:list={[
                'cfg-tab px-3.5 py-2 font-mono text-xs cursor-pointer transition-all',
                i < configTabs.length - 1 && 'border-r border-[rgba(206,66,43,0.3)]',
                i === 0 ? 'active-cfg' : 'text-[#909090] hover:text-[#f0f0f0]',
              ]}
            >{tab.label}</button>
          ))}
        </div>

        <div class="p-5">
          {configTabs.map((tab, i) => (
            <pre
              id={`cfg-${tab.id}`}
              class:list={['cfg-panel font-mono text-[0.8125rem] leading-7 text-[#f0f0f0] m-0 whitespace-pre overflow-x-auto', i > 0 && 'hidden']}
            ><code set:html={panelHtml[tab.id]} /></pre>
          ))}
        </div>
      </div>

    </div>

    <Homelab t={homelabT} lang={lang} />
  </div>
</section>

<style>
  .active-cfg {
    color: var(--color-primary);
    background: rgba(206, 66, 43, 0.08);
  }
</style>

<script>
  import { initTabs } from '../scripts/tabs';

  initTabs({
    tabsSelector: '#cfg-tabs .cfg-tab',
    panelSelector: '.cfg-panel',
    dataAttr: 'file',
    panelIdPrefix: 'cfg-',
    activeClass: 'active-cfg',
  });

  // Animate bars on scroll
  const fills = document.querySelectorAll<HTMLElement>('.skill-fill');
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        (entry.target as HTMLElement).style.animationPlayState = 'running';
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.2 });
  fills.forEach(fill => observer.observe(fill));
</script>
