server {
    listen       ${PORT};
    server_name  _;
    root         /usr/share/nginx/html;
    index        index.html;

    # SPA fallback (на случай будущих under-the-hood маршрутов)
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Кэш для статических ассетов
    location ~* \.(js|css|svg|ico|woff2?)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}
